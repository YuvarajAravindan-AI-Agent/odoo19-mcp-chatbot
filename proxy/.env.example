# Copy to .env and fill in. .env is gitignored — never commit real values.

# Shared secret the Vercel app must send as: Authorization: Bearer <token>
ODOO_PROXY_TOKEN=change-me

# Local Odoo instance
ODOO_URL=http://localhost:8069
ODOO_DB=chatbot_db
ODOO_USER=admin
ODOO_PASSWORD=admin

# CORS origins allowed to call the proxy directly (comma-separated).
ALLOWED_ORIGINS=*
